{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "paths": {
      "@/*": ["./src/*"],
      "src/*": ["./src/*"]
    },
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler"
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
